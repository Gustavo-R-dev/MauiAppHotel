<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Sobre"
             Title="Sobre">
    <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center" HorizontalOptions="Center">
        <Label Text="Hotel App"
               FontFamily="Kalam"
               FontSize="32" 
               TextColor="{StaticResource Primary}"
               FontAttributes="Bold" 
               HorizontalOptions="Center" />

        <Label Text="Versão 1.0" 
               FontSize="16" 
               TextColor="Gray"
               HorizontalOptions="Center" />

        <BoxView HeightRequest="1" Color="#FFD700" WidthRequest="200" />

        <Label Text="Criado por: Gustavo Ramos"
               FontSize="18" 
               HorizontalOptions="Center" />

        <Label Text="Ano de Lançamento: 2026" 
               FontSize="16" 
               HorizontalOptions="Center" />

    </VerticalStackLayout>
</ContentPage>